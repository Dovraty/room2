{
  "$schema": "peepchat-tokens/v1",
  "meta": {
    "name": "PeepChat — Footlights",
    "concept": "The Stage & The Gallery. Warm light = the conversation (stage). Cool glass = the audience (gallery).",
    "version": "0.1.0"
  },
  "color": {
    "dark": {
      "house": "#0E0B0A",
      "stage": "#17120F",
      "stageRaised": "#221B17",
      "stageLine": "rgba(246,238,230,0.10)",
      "scrim": "rgba(8,6,5,0.72)",
      "textPrimary": "#F6EEE6",
      "textSecondary": "#C2B5A8",
      "textTertiary": "#968a80",
      "spotlight": "#FFC46B",
      "spotlightInk": "#FFC46B",
      "onSpotlight": "#1E1306",
      "spotlightGlow": "rgba(255,196,107,0.20)",
      "live": "#FF5A4E",
      "onLive": "#1B0705",
      "liveGlow": "rgba(255,90,78,0.35)",
      "gallery": "#121820",
      "galleryRaised": "#1B232D",
      "galleryLine": "rgba(169,190,214,0.14)",
      "galleryText": "#E3EAF2",
      "galleryTextSecondary": "#A3B2C3",
      "galleryAccent": "#8FC2FF",
      "success": "#5FD39A",
      "focus": "#FFC46B",
      "skeleton": "rgba(246,238,230,0.07)",
      "skeletonHighlight": "rgba(246,238,230,0.14)"
    },
    "light": {
      "house": "#F6F1EA",
      "stage": "#FFFCF8",
      "stageRaised": "#FFFFFF",
      "stageLine": "rgba(27,21,18,0.10)",
      "scrim": "rgba(27,21,18,0.40)",
      "textPrimary": "#1B1512",
      "textSecondary": "#5C5048",
      "textTertiary": "#74675E",
      "spotlight": "#FFB547",
      "spotlightInk": "#9A5B00",
      "onSpotlight": "#1E1306",
      "spotlightGlow": "rgba(255,181,71,0.28)",
      "live": "#D9342A",
      "onLive": "#FFFFFF",
      "liveGlow": "rgba(217,52,42,0.25)",
      "gallery": "#EDF1F5",
      "galleryRaised": "#FFFFFF",
      "galleryLine": "rgba(30,50,75,0.12)",
      "galleryText": "#152230",
      "galleryTextSecondary": "#4A5A6B",
      "galleryAccent": "#1F5FB0",
      "success": "#17804E",
      "focus": "#9A5B00",
      "skeleton": "rgba(27,21,18,0.06)",
      "skeletonHighlight": "rgba(27,21,18,0.12)"
    }
  },
  "chatter": [
    { "id": "coral",     "name": "Coral",     "base": "#FF7A66", "bubbleDark": "#3A1E19", "bubbleLight": "#FFE6E0", "ink": "#B23A26", "glyph": "circle" },
    { "id": "aqua",      "name": "Aqua",      "base": "#3DD6C6", "bubbleDark": "#11302D", "bubbleLight": "#D6F5F1", "ink": "#0B6D64", "glyph": "triangle" },
    { "id": "sky",       "name": "Sky",       "base": "#6AA8FF", "bubbleDark": "#16243A", "bubbleLight": "#E0ECFF", "ink": "#2457B0", "glyph": "square" },
    { "id": "orchid",    "name": "Orchid",    "base": "#E58BE8", "bubbleDark": "#33193A", "bubbleLight": "#F8E2F9", "ink": "#8E2C93", "glyph": "diamond" },
    { "id": "lime",      "name": "Lime",      "base": "#B5E05A", "bubbleDark": "#263212", "bubbleLight": "#EAF5D0", "ink": "#4A670C", "glyph": "star" },
    { "id": "tangerine", "name": "Tangerine", "base": "#FFA24C", "bubbleDark": "#3A2410", "bubbleLight": "#FFEBD6", "ink": "#9C4F08", "glyph": "hexagon" },
    { "id": "rose",      "name": "Rose",      "base": "#FF6FA3", "bubbleDark": "#3A1626", "bubbleLight": "#FFE0EC", "ink": "#AE2358", "glyph": "plus" },
    { "id": "ice",       "name": "Ice",       "base": "#B9A9FF", "bubbleDark": "#231F3D", "bubbleLight": "#ECE8FF", "ink": "#5640C2", "glyph": "ring" }
  ],
  "font": {
    "display": { "black": "Fraunces_900Black", "bold": "Fraunces_700Bold", "semibold": "Fraunces_600SemiBold", "italic": "Fraunces_600SemiBold_Italic" },
    "ui": { "regular": "Inter_400Regular", "medium": "Inter_500Medium", "semibold": "Inter_600SemiBold", "bold": "Inter_700Bold" }
  },
  "type": {
    "hero":     { "family": "display.black",   "size": 44, "lineHeight": 46, "letterSpacing": -1.2 },
    "display":  { "family": "display.bold",    "size": 34, "lineHeight": 38, "letterSpacing": -0.8 },
    "title1":   { "family": "display.bold",    "size": 26, "lineHeight": 30, "letterSpacing": -0.4 },
    "title2":   { "family": "ui.bold",         "size": 20, "lineHeight": 26, "letterSpacing": -0.2 },
    "headline": { "family": "ui.semibold",     "size": 17, "lineHeight": 22, "letterSpacing": -0.1 },
    "body":     { "family": "ui.regular",      "size": 16, "lineHeight": 23, "letterSpacing": 0 },
    "bubble":   { "family": "ui.regular",      "size": 16, "lineHeight": 22, "letterSpacing": 0 },
    "callout":  { "family": "ui.medium",       "size": 15, "lineHeight": 20, "letterSpacing": 0 },
    "footnote": { "family": "ui.regular",      "size": 13, "lineHeight": 18, "letterSpacing": 0 },
    "caption":  { "family": "ui.semibold",     "size": 12, "lineHeight": 16, "letterSpacing": 0.1 },
    "overline": { "family": "ui.bold",         "size": 11, "lineHeight": 14, "letterSpacing": 1.4 },
    "quote":    { "family": "display.italic",  "size": 20, "lineHeight": 26, "letterSpacing": -0.2 }
  },
  "space": { "none": 0, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "x3": 32, "x4": 40, "x5": 56, "x6": 72 },
  "radius": { "xs": 6, "sm": 10, "md": 16, "lg": 22, "xl": 28, "bubble": 20, "bubbleTail": 6, "pill": 999 },
  "size": { "touchMin": 44, "touchMinAndroid": 48, "avatarXs": 24, "avatarSm": 32, "avatarMd": 44, "avatarLg": 64, "avatarXl": 112, "tabBar": 64 },
  "elevation": {
    "stageCard":  { "shadowColor": "#000000", "shadowOpacity": 0.35, "shadowRadius": 24, "shadowOffsetY": 12, "androidElevation": 8 },
    "sheet":      { "shadowColor": "#000000", "shadowOpacity": 0.45, "shadowRadius": 32, "shadowOffsetY": -8, "androidElevation": 16 },
    "spotGlow":   { "shadowColor": "spotlight", "shadowOpacity": 0.55, "shadowRadius": 28, "shadowOffsetY": 0, "androidElevation": 0 },
    "liveGlow":   { "shadowColor": "live", "shadowOpacity": 0.6, "shadowRadius": 14, "shadowOffsetY": 0, "androidElevation": 0 }
  },
  "blur": { "chrome": 40, "sheet": 60, "scrim": 18 },
  "motion": {
    "duration": { "instant": 100, "quick": 180, "base": 280, "slow": 450, "cinematic": 700, "aperture": 720, "pulse": 1100, "pollReveal": 900 },
    "easing": {
      "standard":  [0.2, 0.0, 0.0, 1.0],
      "enter":     [0.05, 0.7, 0.1, 1.0],
      "exit":      [0.3, 0.0, 0.8, 0.15],
      "iris":      [0.65, 0.0, 0.35, 1.0],
      "heartbeat": [0.33, 0.0, 0.2, 1.0]
    },
    "spring": {
      "land":   { "damping": 18, "stiffness": 220, "mass": 0.9 },
      "sheet":  { "damping": 26, "stiffness": 260, "mass": 1.0 },
      "pop":    { "damping": 12, "stiffness": 320, "mass": 0.8 },
      "gentle": { "damping": 20, "stiffness": 120, "mass": 1.0 }
    },
    "signature": {
      "apertureOpen": "Iris closes in from screen edge, then opens on the stage. 720ms iris easing. Haptic: impact.soft at open.",
      "messageLand":  "Bubble rises 14pt + scales 0.96→1 on spring.land, opacity 0→1 over 180ms. No haptic for viewers.",
      "livePulse":    "Double-beat (lub-dub) scale 1→1.25→1→1.12→1 over 1100ms, repeating. Used on live dot + typing.",
      "pollReveal":   "Bars grow from 0 on spring.gentle, staggered 80ms; leader gets spotlight glow. Haptic: impact.medium on vote, notification.success on reveal.",
      "galleryPullUp":"Sheet rides spring.sheet; stage behind scales to 0.94 and dims 40%. Haptic: selection at each detent."
    }
  },
  "haptic": {
    "apertureOpen":  { "type": "impact", "style": "soft" },
    "galleryDetent": { "type": "selection" },
    "pollVote":      { "type": "impact", "style": "medium" },
    "pollReveal":    { "type": "notification", "style": "success" },
    "react":         { "type": "impact", "style": "light" },
    "follow":        { "type": "impact", "style": "rigid" },
    "goLive":        { "type": "notification", "style": "warning" },
    "scrubTick":     { "type": "selection" }
  }
}
